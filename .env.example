# QueueFlow Docker deployment configuration
# Copy this file to .env and replace the placeholders.
# Never commit the real .env file.

POSTGRES_DB=queueflow_deploy
POSTGRES_USER=queueflow
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# Base64-encoded 32-byte encryption keys
GUEST_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
QR_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Laravel frontend origin
WEB_ORIGIN=http://localhost:8000

# Local API port
API_PORT=8080
